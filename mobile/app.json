{
  "expo": {
    "name": "Spotter",
    "slug": "spotter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/spotter-icon.png",
    "scheme": "spotter",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "my.apu.spotter"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/images/spotter-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "my.apu.spotter"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/spotter-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/images/spotter-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      "expo-audio",
      "expo-video",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
